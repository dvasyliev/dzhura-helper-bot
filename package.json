{
  "name": "dzhura-helper-bot",
  "version": "0.15.2",
  "description": "",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "vitest run",
    "setup": "npm install && uv sync && ([ -f .env ] || cp .env.example .env)",
    "start": "pkill -f 'tsx.* src/[i]ndex.ts'; while pgrep -f 'tsx.* src/[i]ndex.ts' >/dev/null; do sleep 0.2; done; caffeinate -i tsx --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "sample": "tsx --env-file-if-exists=.env src/features/audiobook/sample.ts",
    "check": ".claude/hooks/check-all.sh --force",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:file": "prettier --write",
    "lint": "oxlint --deny-warnings",
    "lint:file": "oxlint --deny-warnings",
    "knip": "knip --no-progress --reporter compact",
    "dupes": "jscpd src --threshold 0 --reporters console --format \"javascript,typescript,jsx,tsx,python\"",
    "prepare": "git config core.hooksPath .githooks",
    "deps": "depcruise src --config .dependency-cruiser.cjs --ignore-known --output-type err",
    "deps:baseline": "depcruise-baseline src --config .dependency-cruiser.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@grammyjs/auto-retry": "^2.0.2",
    "grammy": "^1.48.0",
    "jszip": "^3.10.2",
    "node-html-parser": "^9.0.7",
    "p-retry": "^9.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@secretlint/secretlint-rule-preset-recommend": "^13.1.0",
    "@swc/core": "^1.16.22",
    "@types/node": "^26.6.7",
    "dependency-cruiser": "^18.9.0",
    "jscpd": "^5.4.3",
    "knip": "^6.48.0",
    "lint-staged": "^17.6.2",
    "msw": "^2.15.0",
    "oxlint": "^1.95.0",
    "prettier": "^3.10.1",
    "secretlint": "^14.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
